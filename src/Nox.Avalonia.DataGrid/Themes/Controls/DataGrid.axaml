<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme x:Key="{x:Type DataGrid}" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource DataGrid.Static.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource ABrush.Foreground.Static}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGrid.HorizontalSeparatorBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGrid.VerticalSeparatorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DataGrid.Static.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="DropLocationIndicatorTemplate">
            <Template>
                <Rectangle Width="2" Fill="{DynamicResource ABrush.Tone8.Border.Selected}" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="DataGrid">
                <Border Name="DataGridBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*,Auto,Auto">
                        <DataGridColumnHeader Name="PART_TopLeftCornerHeader"
                                              Grid.Row="0" Grid.Column="0" />
                        <DataGridColumnHeadersPresenter Name="PART_ColumnHeadersPresenter"
                                                      Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" />
                        <Rectangle Name="PART_ColumnHeadersAndRowsSeparator"
                                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Height="1" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource DataGrid.HorizontalSeparatorBrush}" />

                        <DataGridRowsPresenter Name="PART_RowsPresenter"
                                               Grid.Row="1" Grid.RowSpan="2"
                                               Grid.Column="0" Grid.ColumnSpan="3"
                                               ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                            <DataGridRowsPresenter.GestureRecognizers>
                                <ScrollGestureRecognizer CanHorizontallyScroll="True"
                                                        CanVerticallyScroll="True"
                                                        IsScrollInertiaEnabled="{Binding #PART_RowsPresenter.(ScrollViewer.IsScrollInertiaEnabled)}" />
                            </DataGridRowsPresenter.GestureRecognizers>
                        </DataGridRowsPresenter>
                        <Rectangle Name="PART_BottomRightCorner"
                                   Grid.Row="2" Grid.Column="2"
                                   Fill="{DynamicResource ABrush.Tone4.Background.Static}" />
                        <ScrollBar Name="PART_VerticalScrollbar"
                                   Grid.Row="1" Grid.Column="2"
                                   AllowAutoHide="{TemplateBinding ScrollViewer.AllowAutoHide}"
                                   Orientation="Vertical" />

                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*">
                            <Rectangle Name="PART_FrozenColumnScrollBarSpacer" Grid.Column="0" />
                            <ScrollBar Name="PART_HorizontalScrollbar"
                                       Grid.Column="1"
                                       AllowAutoHide="{TemplateBinding ScrollViewer.AllowAutoHide}"
                                       Orientation="Horizontal" />
                        </Grid>
                        <Border Name="PART_DisabledVisualElement"
                                Grid.Row="0" Grid.Column="0"
                                Grid.RowSpan="4" Grid.ColumnSpan="3"
                                Background="{DynamicResource ABrush.Tone8.Border.Disabled}"
                                IsHitTestVisible="False"
                                IsVisible="{Binding !$parent[DataGrid].IsEnabled}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:empty-columns">
            <Style Selector="^ /template/ DataGridColumnHeader#PART_TopLeftCornerHeader">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ DataGridColumnHeadersPresenter#PART_ColumnHeadersPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="^[CanUserResizeColumns=True]">
            <Setter Property="GridLinesVisibility" Value="All" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
