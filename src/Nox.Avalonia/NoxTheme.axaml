<Styles
    x:Class="Nox.Avalonia.NoxTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SimpleTheme />

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="avares://Nox.Avalonia/Themes/Colours/BaseDarkTheme.axaml" />
                <ResourceInclude x:Key="Dark" Source="avares://Nox.Avalonia/Themes/Colours/BaseDarkTheme.axaml" />
                <ResourceInclude x:Key="Light" Source="avares://Nox.Avalonia/Themes/Colours/BaseLightTheme.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://Nox.Avalonia/Themes/Controls.axaml" />
</Styles>
