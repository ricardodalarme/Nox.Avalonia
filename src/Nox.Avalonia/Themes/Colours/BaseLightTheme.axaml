    <SolidColorBrush x:Key="Button.Defaulted.Border" Color="{StaticResource ABrush.ColourfulGlyph.Disabled.Color}" />
    <SolidColorBrush x:Key="ButtonSpinner.Error.Border" Color="Red" />
