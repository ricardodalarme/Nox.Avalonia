    <!--  This file contains general-purpose brushes used by our control themes  -->

    <!--
        ##### NOTE ON StaticResource USAGE #####
        We use the ThemeManager's inheritance system to automatically update the keys when the values change
        (as in, 'PanelBorderBrush' is updated when 'ABrush.Tone1.Border.Static' changes).
        Therefore, there's no reason to use dynamic resource.
        
        We set the Color anyway so that it makes designing UIs easier, since
        the ThemeManager may not load properly in the designer runtime
        
        See ThemeManagerImpl.SetupGeneralMappingsAndInheritance
    -->

    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource ABrush.Tone1.Border.Static.Color}" />
    <SolidColorBrush x:Key="PanelBackground0" Color="{StaticResource ABrush.Tone0.Background.Static.Color}" />
    <SolidColorBrush x:Key="PanelBackground1" Color="{StaticResource ABrush.Tone1.Background.Static.Color}" />
    <SolidColorBrush x:Key="PanelBackground2" Color="{StaticResource ABrush.Tone2.Background.Static.Color}" />
    <SolidColorBrush x:Key="PanelBackground3" Color="{StaticResource ABrush.Tone3.Background.Static.Color}" />
    <SolidColorBrush x:Key="PanelBackground4" Color="{StaticResource ABrush.Tone4.Background.Static.Color}" />

    <SolidColorBrush x:Key="Button.Static.Background" Color="{StaticResource ABrush.Tone5.Background.Static.Color}" />
    <SolidColorBrush x:Key="Button.Static.Border" Color="{StaticResource ABrush.Tone5.Border.Static.Color}" />
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="{StaticResource ABrush.Tone5.Background.MouseOver.Color}" />
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="{StaticResource ABrush.Tone5.Border.MouseOver.Color}" />
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="{StaticResource ABrush.Tone5.Background.MouseDown.Color}" />
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="{StaticResource ABrush.Tone5.Border.MouseDown.Color}" />
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="{StaticResource ABrush.Tone5.Background.Disabled.Color}" />
